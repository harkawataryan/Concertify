# Spotify app credentials: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8088/auth/callback

# Ticketmaster Discovery API key: https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Required in production; any long random string.
SESSION_SECRET=change-me

PORT=8088
FRONTEND_URL=http://127.0.0.1:5173

# Optional. When set, the cache is shared across server instances.
# REDIS_URL=redis://localhost:6379

# Deployed only: public HTTPS URL (Render sets RENDER_EXTERNAL_URL automatically)
# and the built client directory to serve from this process.
# PUBLIC_URL=
# CLIENT_DIST=

# Optional tuning
# TM_RPS=5
# TM_CONCURRENCY=3
# CACHE_MAX_ENTRIES=5000
# RATE_LIMIT_MAX=60
# LOG_LEVEL=info

# gRPC sidecars (set by the Docker image; leave unset to run everything in-process)
# RANKER_ADDR=127.0.0.1:50051
# TRAINER_ADDR=127.0.0.1:50052
# Optional. The sp_dc session cookie from developer.spotify.com, logged in as the
# app owner. When set, visitors can add themselves to the Development Mode
# allowlist from the landing page (oldest entry is evicted when all five slots
# are taken). Leave empty to show the plain login button.
SPOTIFY_DASHBOARD_SP_DC=
# Emails that can always log in (the app owner), skipped by the allowlist step.
SPOTIFY_OWNER_EMAILS=harkawat.aryan@gmail.com
