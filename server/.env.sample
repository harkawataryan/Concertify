# Spotify app credentials: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8088/auth/callback

# Ticketmaster Discovery API key: https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Required in production; any long random string.
SESSION_SECRET=change-me

PORT=8088
FRONTEND_URL=http://127.0.0.1:5173

# Optional. When set, the cache is shared across server instances.
# REDIS_URL=redis://localhost:6379

# Optional tuning
# TM_RPS=5
# TM_CONCURRENCY=3
# CACHE_MAX_ENTRIES=5000
# RATE_LIMIT_MAX=60
# LOG_LEVEL=info
